# URL du backend NestJS (foot-analytics-api). Si absente ou injoignable,
# l'app retombe automatiquement sur les donnees locales de demonstration.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Mon club ---------------------------------------------------------------
# Id du club "proprietaire" (le tien), tel qu'il apparait dans GET /api/clubs.
# Exemple en mode demo : "ols" pour Olympique Lyon Sud. Par defaut : "chapo".
NEXT_PUBLIC_CLUB_ID=chapo
# Nom d'affichage de repli si le club n'est pas encore charge depuis l'API.
NEXT_PUBLIC_CLUB_NOM=FC Chaponnay-Marennes

# --- Diagnostic --------------------------------------------------------------
# 1 = active les traces console.debug du front ([switcher], [effectif], [middleware]...).
NEXT_PUBLIC_DEBUG=0
