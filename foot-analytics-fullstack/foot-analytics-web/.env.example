# URL du backend NestJS (foot-analytics-api), vue du serveur Next uniquement : le navigateur passe par le relais
# /api/backend. Si absente, NEXT_PUBLIC_API_URL est lue ; si l'API est injoignable, l'app retombe sur les donnees
# locales de demonstration.
API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Secret partage avec l'API (meme valeur que BFF_SECRET cote API) : l'adresse IP des visiteurs est transmise a l'API
# pour ses limites de connexion. Generer : openssl rand -hex 32. Optionnel en developpement.
BFF_SECRET=

# --- Mon club ---------------------------------------------------------------
# Id du club "proprietaire" (le tien), tel qu'il apparait dans GET /api/clubs.
# Exemple en mode demo : "ols" pour Olympique Lyon Sud. Par defaut : "chapo".
NEXT_PUBLIC_CLUB_ID=chapo
# Nom d'affichage de repli si le club n'est pas encore charge depuis l'API.
NEXT_PUBLIC_CLUB_NOM=FC Chaponnay-Marennes

# --- Diagnostic --------------------------------------------------------------
# 1 = active les traces console.debug du front ([switcher], [effectif], [middleware]...).
NEXT_PUBLIC_DEBUG=0
