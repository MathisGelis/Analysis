{
  "name": "foot-analytics-api",
  "version": "0.1.0",
  "description": "Backend NestJS pour Foot Analytics — CRUD effectif, matchs, entrainements, scouting + import FMI",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/features/seed/seed.cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "db:copier": "ts-node -r tsconfig-paths/register src/database/copie-sqlite-vers-postgres.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "11.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.5",
    "fflate": "0.8.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sql.js": "1.14.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "20.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.4"
  },
  "overrides": {
    "test-exclude": "^8.0.0",
    "typeorm": {
      "glob": "^13.0.6"
    },
    "js-yaml": {
      "argparse": "^2.0.1"
    }
  }
}
