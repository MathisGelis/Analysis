# Port d'ecoute de l'API
PORT=4000

# Origine autorisee pour CORS (le front Next.js)
CORS_ORIGIN=http://localhost:3000

# --- Base de donnees ---------------------------------------------------------
# DB_TYPE = sqlite (par defaut, zero config) ou postgres (Supabase / serveur PG)
DB_TYPE=sqlite

# Chemin du fichier SQLite (si DB_TYPE=sqlite)
SQLITE_PATH=foot-analytics.sqlite

# Connexion Postgres / Supabase (si DB_TYPE=postgres)
# Recuperez l'URL dans Supabase > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Parser FMI --------------------------------------------------------------
# Commande Python utilisee pour lancer le parseur (python3 par defaut)
PYTHON_BIN=python3
# Chemin du script de parsing
FMI_PARSER_PATH=parser/parse_fmi.py

# Re-seed automatique au demarrage si la base est vide (true/false)
AUTO_SEED=true

# --- Journalisation ----------------------------------------------------------
# fatal | error | warn | log (defaut) | debug | verbose
# LOG_LEVEL=debug active les traces de diagnostic (clone de saison, effectif, attache).
LOG_LEVEL=log

# Au demarrage, fusionne les equipes provisoires clonees de la saison precedente
# qui font doublon avec la vraie equipe (autre poule). true par defaut.
AUTO_RECONCILE=true
