# Port d'ecoute de l'API
PORT=4000

# Origine autorisee pour CORS (le front Next.js)
CORS_ORIGIN=http://localhost:3000

# --- Base de donnees ---------------------------------------------------------
# DB_TYPE = sqlite (par defaut, zero config) ou postgres (Supabase / serveur PG)
DB_TYPE=sqlite

# Chemin du fichier SQLite (si DB_TYPE=sqlite)
SQLITE_PATH=foot-analytics.sqlite

# Connexion Postgres / Supabase (si DB_TYPE=postgres)
# Supabase : bouton "Connect" > chaine "Session pooler" (port 5432), pas le "Transaction pooler" (6543).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# SSL : off | require (defaut hors local, sans verifier le certificat) | verify (avec DB_SSL_CA)
# DB_SSL=require
# DB_SSL_CA=/chemin/prod-ca.crt
# DB_POOL_MAX=10
# Migrations appliquees au demarrage (false pour les lancer a la main : npm run migration:run)
# DB_MIGRATIONS_RUN=true

# --- Parser FMI --------------------------------------------------------------
# Commande Python utilisee pour lancer le parseur (python3 par defaut)
PYTHON_BIN=python3
# Chemin du script de parsing
FMI_PARSER_PATH=parser/parse_fmi.py

# Peuplement de demo au demarrage si la base est vide (true/false). Defaut : true en SQLite, false en Postgres.
AUTO_SEED=true

# --- Journalisation ----------------------------------------------------------
# fatal | error | warn | log (defaut) | debug | verbose
# LOG_LEVEL=debug active les traces de diagnostic (clone de saison, effectif, attache).
LOG_LEVEL=log

# Au demarrage, fusionne les equipes provisoires clonees de la saison precedente
# qui font doublon avec la vraie equipe (autre poule). true par defaut.
AUTO_RECONCILE=true
